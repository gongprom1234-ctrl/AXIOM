-- สวิตช์ดึงทุกคนมาหาตลอดเวลา
MainTab:CreateToggle({
   Name = "ดึงทุกคนมาหาเรื่อยๆ (Bring All Loop)",
   CurrentValue = false,
   Flag = "BringLoopToggle",
   Callback = function(Value)
      BringPlayersLoop = Value
      task.spawn(function()
         while BringPlayersLoop do
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
               local myPos = LocalPlayer.Character.HumanoidRootPart.CFrame
               for _, player in pairs(Players:GetPlayers()) do
                  if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                     player.Character.HumanoidRootPart.CFrame = myPos * CFrame.new(0, 0, -3)
                  end
               end
            end
            task.wait(0.1)
         end
      end)
   end,
})

